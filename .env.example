# ==============================================================================
# MEDGUARD AI - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and fill in your credentials
# ==============================================================================

# --- Supabase Configuration ---
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_anon_key

# Supabase Service Role Key (Backend / Admin only - keep private)
SUPABASE_SERVICE_ROLE_KEY=

# --- Resend Email Service ---
RESEND_API_KEY=your_resend_api_key
VITE_RESEND_API_KEY=your_resend_api_key

# --- AI Medicine Scanner ---
# Gemini / Gemma API key for medicine strip OCR and parsing
GEMMA_API_KEY=
VITE_GEMINI_API_KEY=
