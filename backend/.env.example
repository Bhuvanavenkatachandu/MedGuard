# MedGuard AI Backend Environment Configuration Example
DATABASE_URL=sqlite:///./data/medguard.db
JWT_SECRET=your_jwt_secret_key_here
JWT_SECRET_KEY=your_jwt_secret_key_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=43200

# Gemma 4 Multimodal Model
GEMMA_API_KEY=your_gemma_or_google_ai_studio_key_here
GEMMA_MODEL=gemma-4-26b-a4b-it

# Optional Generic SMTP Email Configuration (Non-blocking)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=your_smtp_user
SMTP_PASSWORD=your_smtp_password
SMTP_FROM=noreply@yourdomain.com

CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
STORAGE_DIR=./storage
